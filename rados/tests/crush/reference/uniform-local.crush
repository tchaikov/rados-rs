# Local C-mapper contract: no selected upstream ordered Uniform oracle exists.
tunable choose_local_tries 0
tunable choose_local_fallback_tries 0
tunable choose_total_tries 2
tunable chooseleaf_descend_once 1

device 0 device0
device 1 device1
device 2 device2

type 0 device
type 1 root

root uniform-root {
    id -1
    alg uniform
    hash 0
    item device0 weight 1.00000
    item device1 weight 1.00000
    item device2 weight 1.00000
}

rule firstn {
    id 0
    type replicated
    step take uniform-root
    step choose firstn 0 type device
    step emit
}

rule indep {
    id 1
    type erasure
    step take uniform-root
    step choose indep 0 type device
    step emit
}
